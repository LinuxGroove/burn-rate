; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Burn Rate"
config/description="One button to fly, three lanes to dodge in. A jetpack runner through a downtown tower."
config/version="0.1.0"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.07058824, 0.0627451, 0.09411765, 1)
boot_splash/image="res://addons/linuxgroove/splash/splash.png"
boot_splash/minimum_display_time=1500
boot_splash/stretch_mode=4
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="burn-rate"

[autoload]

LGSettings="*res://addons/linuxgroove/core/settings.gd"
LGAudio="*res://addons/linuxgroove/core/audio_director.gd"
LGInput="*res://addons/linuxgroove/input/input_router.gd"
LGScenes="*res://addons/linuxgroove/core/scene_switcher.gd"
Nakama="*res://addons/com.heroiclabs.nakama/Nakama.gd"
LGOnline="*res://addons/linuxgroove/online/online_service.gd"
Session="*res://game/net/session.gd"
Progress="*res://game/progress.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.03, 0.035, 0.06, 1)
anti_aliasing/quality/msaa_3d=2
renderer/rendering_method.mobile="mobile"

[shader_globals]

steady={
"type": "float",
"value": 0.0
}

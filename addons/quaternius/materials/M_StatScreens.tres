code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 Color_A : source_color = vec4(1.000000, 0.000000, 0.000000, 1.000000);
uniform sampler2D ScreenTexture : source_color;
uniform vec4 Color_B : source_color = vec4(0.309804, 0.850980, 0.000000, 1.000000);
uniform vec4 Base_Color : source_color = vec4(0.650980, 1.000000, 0.125490, 1.000000);
uniform float Emissive_Intensity = 4;
uniform float Speed = 3;
uniform float Background_Opacity = 0.10000000149012;



void fragment() {
// ColorParameter:4
	vec4 n_out4p0 = Color_A;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(ScreenTexture, UV);


// VectorDecompose:16
	float n_out16p0 = n_out3p0.x;
	float n_out16p1 = n_out3p0.y;
	float n_out16p2 = n_out3p0.z;
	float n_out16p3 = n_out3p0.w;


// Mix:32
	vec4 n_in32p0 = vec4(0.00000, 0.00000, 0.00000, 0.00000);
	vec4 n_out32p0 = mix(n_in32p0, n_out4p0, vec4(n_out16p0));


// ColorParameter:5
	vec4 n_out5p0 = Color_B;


// Mix:33
	vec4 n_out33p0 = mix(n_out32p0, n_out5p0, vec4(n_out16p1));


// ColorParameter:6
	vec4 n_out6p0 = Base_Color;


// Mix:34
	vec4 n_out34p0 = mix(n_out33p0, n_out6p0, vec4(n_out16p2));


// FloatParameter:7
	float n_out7p0 = Emissive_Intensity;


// VectorOp:35
	vec4 n_out35p0 = n_out34p0 * vec4(n_out7p0);


// Input:9
	float n_out9p0 = TIME;


// FloatParameter:11
	float n_out11p0 = Speed;


// FloatOp:12
	float n_out12p0 = n_out9p0 * n_out11p0;


// FloatFunc:10
	float n_out10p0 = sin(n_out12p0);


// FloatOp:13
	float n_in13p1 = 2.00000;
	float n_out13p0 = n_out10p0 * n_in13p1;


// Clamp:14
	float n_in14p1 = 0.00000;
	float n_in14p2 = 1.00000;
	float n_out14p0 = clamp(n_out13p0, n_in14p1, n_in14p2);


// Mix:15
	float n_in15p1 = 0.00000;
	float n_out15p0 = mix(n_out16p0, n_in15p1, n_out14p0);


// FloatOp:19
	float n_out19p0 = n_out9p0 * n_out11p0;


// FloatOp:23
	float n_in23p1 = 3.00000;
	float n_out23p0 = n_out19p0 + n_in23p1;


// FloatFunc:20
	float n_out20p0 = sin(n_out23p0);


// FloatOp:21
	float n_in21p1 = 2.00000;
	float n_out21p0 = n_out20p0 * n_in21p1;


// Clamp:22
	float n_in22p1 = 0.00000;
	float n_in22p2 = 1.00000;
	float n_out22p0 = clamp(n_out21p0, n_in22p1, n_in22p2);


// Mix:24
	float n_in24p1 = 0.00000;
	float n_out24p0 = mix(n_out16p1, n_in24p1, n_out22p0);


// FloatOp:25
	float n_out25p0 = n_out15p0 + n_out24p0;


// FloatOp:26
	float n_out26p0 = n_out16p2 + n_out25p0;


// Clamp:27
	float n_in27p1 = 0.00000;
	float n_in27p2 = 1.00000;
	float n_out27p0 = clamp(n_out26p0, n_in27p1, n_in27p2);


// FloatParameter:8
	float n_out8p0 = Background_Opacity;


// FloatOp:29
	float n_out29p0 = n_out27p0 * n_out8p0;


// Input:30
	vec4 n_out30p0 = COLOR;


// VectorDecompose:31
	float n_out31p0 = n_out30p0.x;
	float n_out31p1 = n_out30p0.y;
	float n_out31p2 = n_out30p0.z;
	float n_out31p3 = n_out30p0.w;


// Mix:28
	float n_out28p0 = mix(n_out27p0, n_out29p0, n_out31p1);


// Output:0
	ALBEDO = vec3(n_out35p0.xyz);
	ALPHA = n_out28p0;
	EMISSION = vec3(n_out35p0.xyz);


}

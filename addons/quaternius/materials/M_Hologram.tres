[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 Location_Pin_Color : source_color = vec4(1.000000, 0.031373, 0.000000, 1.000000);
uniform vec4 Hologram_Color : source_color = vec4(0.000000, 1.000000, 1.000000, 1.000000);
uniform float Texture_Speed = 0.01499999966472;
uniform sampler2D Texture;
uniform float Emissive_Intensity = 2;



void fragment() {
// ColorParameter:19
	vec4 n_out19p0 = Location_Pin_Color;


// FloatConstant:24
	float n_out24p0 = 0.300000;


// VectorOp:20
	vec4 n_out20p0 = n_out19p0 * vec4(n_out24p0);


// ColorConstant:15
	vec4 n_out15p0 = vec4(0.000000, 0.000000, 0.000000, 1.000000);


// ColorParameter:16
	vec4 n_out16p0 = Hologram_Color;


// Input:11
	vec4 n_out11p0 = COLOR;


// VectorDecompose:12
	float n_out12p0 = n_out11p0.x;
	float n_out12p1 = n_out11p0.y;
	float n_out12p2 = n_out11p0.z;
	float n_out12p3 = n_out11p0.w;


// Mix:14
	vec4 n_out14p0 = mix(n_out15p0, n_out16p0, vec4(n_out12p0));


// FloatConstant:22
	float n_out22p0 = 0.300000;


// VectorOp:21
	vec4 n_out21p0 = n_out14p0 * vec4(n_out22p0);


// Mix:18
	vec4 n_out18p0 = mix(n_out20p0, n_out21p0, vec4(n_out12p1));


// Input:2
	float n_out2p0 = TIME;


// FloatParameter:6
	float n_out6p0 = Texture_Speed;


// FloatOp:3
	float n_out3p0 = n_out2p0 * n_out6p0;


// VectorCompose:5
	float n_in5p1 = 0.00000;
	vec2 n_out5p0 = vec2(n_out3p0, n_in5p1);


// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_out4p0 = n_out5p0 * n_in4p1 + UV;


	vec4 n_out8p0;
// Texture2D:8
	n_out8p0 = texture(Texture, n_out4p0);


// Mix:10
	float n_in10p0 = 0.00000;
	float n_out10p0 = mix(n_in10p0, n_out8p0.x, n_out12p0);


// Mix:13
	float n_in13p0 = 1.00000;
	float n_out13p0 = mix(n_in13p0, n_out10p0, n_out12p1);


// FloatParameter:25
	float n_out25p0 = Emissive_Intensity;


// VectorOp:23
	vec4 n_out23p0 = n_out18p0 * vec4(n_out25p0);


// Output:0
	ALBEDO = vec3(n_out18p0.xyz);
	ALPHA = n_out13p0;
	EMISSION = vec3(n_out23p0.xyz);


}

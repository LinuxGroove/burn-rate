[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D Base_Color : source_color;
uniform sampler2D ORM;
uniform float Emissive_Intensity = 6;
uniform sampler2D Emissive_Texture : hint_normal;
uniform vec4 Emissive_Color : source_color = vec4(0.678357, 0.327000, 0.000001, 1.000000);
uniform sampler2D Normal : hint_normal;



void fragment() {
	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Base_Color, UV);


	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(ORM, UV);


// VectorDecompose:7
	float n_out7p0 = n_out6p0.x;
	float n_out7p1 = n_out6p0.y;
	float n_out7p2 = n_out6p0.z;
	float n_out7p3 = n_out6p0.w;


// FloatParameter:13
	float n_out13p0 = Emissive_Intensity;


	vec4 n_out11p0;
// Texture2D:11
	n_out11p0 = texture(Emissive_Texture, UV);


// ColorParameter:12
	vec4 n_out12p0 = Emissive_Color;


// VectorOp:14
	vec4 n_out14p0 = n_out11p0 * n_out12p0;


// VectorOp:15
	vec4 n_out15p0 = vec4(n_out13p0) * n_out14p0;


	vec4 n_out9p0;
// Texture2D:9
	n_out9p0 = texture(Normal, UV);


// Output:0
	ALBEDO = vec3(n_out3p0.xyz);
	METALLIC = n_out7p2;
	ROUGHNESS = n_out7p1;
	EMISSION = vec3(n_out15p0.xyz);
	AO = n_out7p0;
	NORMAL_MAP = vec3(n_out9p0.xyz);


}

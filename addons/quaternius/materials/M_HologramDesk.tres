code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 Small_Grid_Color : source_color = vec4(0.000000, 1.000000, 1.000000, 1.000000);
uniform float Grid_Speed = 0.02500000037253;
uniform sampler2D Table_Texture : source_color;
uniform vec4 Big_Grid_Color : source_color = vec4(0.000000, 0.284428, 0.284428, 1.000000);
uniform float Big_Grid_Speed = 0.01300000026822;



void fragment() {
// ColorParameter:12
	vec4 n_out12p0 = Small_Grid_Color;


// ColorConstant:11
	vec4 n_out11p0 = vec4(0.000000, 0.000000, 0.000000, 1.000000);


// Input:2
	float n_out2p0 = TIME;


// FloatParameter:8
	float n_out8p0 = Grid_Speed;


// FloatOp:3
	float n_out3p0 = n_out2p0 * n_out8p0;


// VectorCompose:5
	float n_in5p1 = 0.00000;
	vec2 n_out5p0 = vec2(n_out3p0, n_in5p1);


// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_out4p0 = n_out5p0 * n_in4p1 + UV;


	vec4 n_out7p0;
// Texture2D:7
	n_out7p0 = texture(Table_Texture, n_out4p0);


// VectorDecompose:9
	float n_out9p0 = n_out7p0.x;
	float n_out9p1 = n_out7p0.y;
	float n_out9p2 = n_out7p0.z;
	float n_out9p3 = n_out7p0.w;


// Mix:10
	vec4 n_out10p0 = mix(n_out11p0, n_out12p0, vec4(n_out9p0));


// ColorParameter:22
	vec4 n_out22p0 = Big_Grid_Color;


// Input:14
	float n_out14p0 = TIME;


// FloatParameter:19
	float n_out19p0 = Big_Grid_Speed;


// FloatOp:17
	float n_out17p0 = n_out14p0 * n_out19p0;


// VectorCompose:16
	vec2 n_out16p0 = vec2(n_out17p0, n_out17p0);


// UVFunc:15
	vec2 n_in15p1 = vec2(1.00000, 1.00000);
	vec2 n_out15p0 = n_out16p0 * n_in15p1 + UV;


	vec4 n_out18p0;
// Texture2D:18
	n_out18p0 = texture(Table_Texture, n_out15p0);


// VectorDecompose:20
	float n_out20p0 = n_out18p0.x;
	float n_out20p1 = n_out18p0.y;
	float n_out20p2 = n_out18p0.z;
	float n_out20p3 = n_out18p0.w;


// Mix:21
	vec4 n_out21p0 = mix(n_out11p0, n_out22p0, vec4(n_out20p1));


// VectorOp:13
	vec4 n_out13p0 = n_out10p0 + n_out21p0;


// Input:24
	vec4 n_out24p0 = COLOR;


// VectorDecompose:25
	float n_out25p0 = n_out24p0.x;
	float n_out25p1 = n_out24p0.y;
	float n_out25p2 = n_out24p0.z;
	float n_out25p3 = n_out24p0.w;


// Mix:23
	vec4 n_out23p0 = mix(n_out12p0, n_out13p0, vec4(n_out25p0));


// Output:0
	ALBEDO = vec3(n_out23p0.xyz);
	EMISSION = vec3(n_out23p0.xyz);


}
